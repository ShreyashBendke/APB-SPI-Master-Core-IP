`timescale 1ns/1ps

module spi_baud_generator_tb;

    //=========================================================
    // Input Declarations
    //=========================================================

    reg         PCLK;
    reg         PRESET_n;
    reg [1:0]   spi_mode_i;
    reg         spiswai_i;
    reg [2:0]   sppr_i;
    reg [2:0]   spr_i;
    reg         cpol_i;
    reg         cpha_i;
    reg         ss_i;

    //=========================================================
    // Output Declarations
    //=========================================================

    wire        sclk_o;
    wire        miso_receive_sclk_o;
    wire        miso_receive_sclk0_o;
    wire        mosi_send_sclk0_o;
    wire        mosi_send_sclk_o;
    wire[11:0]  BaudRateDivisor;

    //=========================================================
    // DUT Instantiation
    //=========================================================

    spi_baud_generator DUT
    (
        .PCLK(PCLK),
        .PRESET_n(PRESET_n),
        .spi_mode_i(spi_mode_i),
        .spiswai_i(spiswai_i),
        .sppr_i(sppr_i),
        .spr_i(spr_i),
        .cpol_i(cpol_i),
        .cpha_i(cpha_i),
        .ss_i(ss_i),
        .sclk_o(sclk_o),
        .miso_receive_sclk_o(miso_receive_sclk_o),
        .miso_receive_sclk0_o(miso_receive_sclk0_o),
        .mosi_send_sclk0_o(mosi_send_sclk0_o),
        .mosi_send_sclk_o(mosi_send_sclk_o),
        .BaudRateDivisor(BaudRateDivisor)
    );

    //=========================================================
    // Clock Generation
    //=========================================================

    initial
        PCLK = 1'b0;

    always #5 PCLK = ~PCLK;

    //=========================================================
    // Initialize Task
    //=========================================================

    task initialize;
    begin
        spi_mode_i = 2'b0;
        sppr_i     = 3'b0;
        spr_i      = 3'b0;
        cpol_i     = 1'b0;
        cpha_i     = 1'b1;
        ss_i       = 1'b1;
        spiswai_i  = 1'b0;
        PRESET_n   = 1'b0;
    end
    endtask

    //=========================================================
    // Reset Task
    //=========================================================

    task reset;
    begin
        #1;
        PRESET_n = 1'b0;
        #43;
        PRESET_n = 1'b1;
    end
    endtask

    //=========================================================
    // Baud Generator Configuration Task
    //=========================================================

    task baud_gen(input [2:0] i, j, input m, n);
    begin
        spi_mode_i = 2'b01;     
        sppr_i     = i;
        spr_i      = j;
        cpol_i     = m;
        cpha_i     = n;
        ss_i       = 1'b0;
        spiswai_i  = 1'b0;
    end
    endtask

    //=========================================================
    // Test Sequence
    //=========================================================

    initial
    begin
        initialize;
        #10;
        reset;
        #10;

        baud_gen(3'd1,3'd1,1'b1,1'b0);
        #200;

        baud_gen(3'd0,3'd1,1'b0,1'b1);
        #200;

        baud_gen(3'd0,3'd2,1'b1,1'b1);
        #600;
        spiswai_i = 1'b1;   // stop sck generation

        #4000;
        $finish();
    end

endmodule