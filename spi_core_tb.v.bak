`define SPI_APB_DATA_WIDTH 8
`define SPI_REG_WIDTH      8
`define SPI_APB_ADDR_WIDTH 3

module spi_core_tb();

    reg PCLK;
    reg PRESET_n;
    reg [2:0] PADDR_i;
    reg PWRITE_i,PSEL_i,PENABLE_i;
    reg [7:0] PWDATA;
    reg miso;
    wire ss;
    wire SCLK;
    wire spi_interrupt_request;
    wire mosi;
    wire [7:0] PRDATA;
    wire PREADY; 
    wire PSLVERR;
integer k;
    
spi_core DUT( .PCLK(PCLK),
                 .PRESET_n(PRESET_n),
                 .PADDR(PADDR),
                 .PWRITE(PWRITE),
                 .PSEL(PSEL),
                 .PENABLE(PENABLE),
                 .PWDATA(PWDATA),
                 .miso(miso),
                 .ss(ss),
                 .SCLK(SCLK),
                 .spi_interrupt_request(spi_interrupt_request),
                 .mosi(mosi),
                 .PRDATA(PRDATA),
                 .PREADY(PREADY),
                 .PSLVERR(PSLVERR));
    
    initial
        PCLK = 1'b0;
    always
        #5 PCLK = ~PCLK;
    
    task reset;
        begin
            PRESET_n = 1'b0;
            #15;
            PRESET_n = 1'b1;
        end
    endtask
    
    task spi_config_reg(input [7:0] data,input [2:0] addr);
        begin
            @(negedge PCLK);
            PADDR = addr;
            PWDATA = data;
            PSEL = 1'b1;
            PENABLE = 1'b0;
            PWRITE = 1'b1;
            @(negedge PCLK);
            PENABLE = 1'b1;            
            wait(!PREADY)
            @(negedge PCLK);
            PSEL = 1'b0;
            PENABLE = 1'b0;
            @(negedge PCLK);
        end
    endtask
    
    task spi_config_SR(input [2:0] addr);
        begin
            @(negedge PCLK);
            PADDR = addr;
            PSEL = 1'b1;
            PENABLE = 1'b0;
            PWRITE = 1'b0;
            @(negedge PCLK);
            PENABLE = 1'b1;            
            wait(!PREADY)
            @(negedge PCLK);
            PSEL = 1'b0;
            PENABLE = 1'b0;
            @(negedge PCLK);
        end
    endtask

    task serial_input_miso(input [7:0] in);
        begin
             wait(~ss);
               
                for(k=0;k<8;k=k+1)
                    begin
                        @(posedge SCLK)
                        miso = in[k];
                                
                      end
                             @(negedge PCLK);
                             @(negedge PCLK);
            PADDR = 3'd5;
            PSEL = 1'b1;
            PENABLE = 1'b0;
            PWRITE = 1'b0;
            @(negedge PCLK);
                        @(negedge PCLK);
                        @(negedge PCLK);

            PENABLE = 1'b1;            
            wait(!PREADY)
          
            @(negedge PCLK);
            PSEL = 1'b0;
            PENABLE = 1'b0;
            @(negedge PCLK);
                   
        end
    endtask
    
    initial
        begin
            reset;
            spi_config_reg(8'b1111_0111,3'd0);//CR1
            spi_config_reg(8'b0001_0010,3'd1);//CR2 2nd bit is Spiswai
            spi_config_reg(8'b0000_0001,3'd2);//BR-4
            spi_config_SR(3'd3);//SR
            spi_config_reg(8'd68,3'd5);//DR
            serial_input_miso(8'b10101010);
            #5;
                           
            #500 $finish;

        end
    
endmodule
